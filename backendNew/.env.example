DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/toyculture"
PORT=5000
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_SECRET=your_razorpay_secret
EMAIL=your_smtp_email
PASS=your_smtp_password
JWT_SECRET=your_jwt_secret
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
# Set to true only for local API testing without login (not for production)
ALLOW_DEV_AUTH_BYPASS=false
# Pincode admin list is optional; set true later to allow only listed pincodes
SHIPPING_ENFORCE_WHITELIST=false
OTP_INVALID_TIME=120
OTP_EXPIRY_TIME=300
OTP_VERIFY_LIMIT=3
